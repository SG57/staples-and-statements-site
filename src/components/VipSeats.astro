---
/**
 * VIP membership seats — luxury scarcity display for /services/vip.
 * Seat counts come from src/data/vip.ts; never hardcode availability here.
 * Scroll-reveal is automatic: BaseLayout's engine staggers grid children.
 */
import { vipSeats } from '../data/vip';

const numerals = ['I', 'II', 'III', 'IV'];
const seats = Array.from({ length: vipSeats.total }, (_, i) => ({
  numeral: numerals[i] ?? String(i + 1),
  reserved: i < vipSeats.filled,
}));
const open = vipSeats.total - vipSeats.filled;
---

<section
  class="py-20 lg:py-28 px-6 bg-primary overflow-hidden"
  aria-label="VIP membership availability"
  data-compact-super="Membership"
  data-compact-title="The Seats"
  data-compact-theme="dark"
>
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col items-center text-center mb-14">
      <div class="w-8 h-px bg-accent mb-4"></div>
      <p class="font-body text-xs tracking-widest uppercase text-accent mb-3">Membership</p>
      <h2 class="font-heading text-white text-4xl lg:text-5xl">Three seats. Never more.</h2>
      <p class="mt-5 font-body text-white/60 text-base lg:text-lg leading-relaxed max-w-xl">
        VIP is a working partnership, not a product. To protect the depth of attention
        each client receives, capacity is capped at three concurrent engagements &mdash;
        when the seats are full, the doors close.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-5xl mx-auto">
      {seats.map((seat) =>
        seat.reserved ? (
          <div class="vip-seat vip-seat--reserved s-sk flex flex-col items-center text-center px-8 py-14">
            <p class="font-heading text-7xl leading-none text-accent/50" aria-hidden="true">{seat.numeral}</p>
            <div class="vip-seal my-9">
              <span class="font-heading text-xl text-accent tracking-wide">S&amp;S</span>
            </div>
            <p class="font-body text-xs tracking-[0.3em] uppercase text-accent">Reserved</p>
            <p class="mt-2 font-body text-sm text-white/40 italic">In residence</p>
          </div>
        ) : (
          <a href="/contact" class="vip-seat vip-seat--open group flex flex-col items-center text-center px-8 py-14">
            <p class="font-heading text-7xl leading-none text-white/20 transition-colors group-hover:text-accent/60" aria-hidden="true">{seat.numeral}</p>
            <div class="vip-seal vip-seal--open my-9"></div>
            <p class="font-body text-xs tracking-[0.3em] uppercase text-white/80">Open</p>
            <p class="mt-2 font-body text-sm text-white/40 italic">Awaiting its client</p>
            <span class="mt-8 inline-flex items-center gap-2 font-body text-xs tracking-widest uppercase text-accent">
              Request This Seat
              <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
            </span>
          </a>
        )
      )}
    </div>

    <p class="mt-12 text-center font-body text-xs tracking-[0.25em] uppercase text-white/30">
      {open > 0
        ? `${open} of ${vipSeats.total} seats currently open`
        : 'Membership is currently full — inquire to join the waitlist'}
    </p>
  </div>
</section>

<style>
  .vip-seat {
    position: relative;
    background:
      radial-gradient(120% 80% at 50% 0%, rgba(184, 151, 126, 0.10) 0%, transparent 60%),
      linear-gradient(180deg, #26211d 0%, #1a1613 100%);
    border: 1px solid rgba(184, 151, 126, 0.22);
    transition:
      border-color calc(var(--dur) * 0.65) var(--ease),
      box-shadow   calc(var(--dur) * 0.9)  var(--ease),
      transform    calc(var(--dur) * 0.65) var(--ease);
  }

  /* Inner gold hairline — framed-invitation detail */
  .vip-seat::after {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid rgba(184, 151, 126, 0.14);
    pointer-events: none;
    transition: border-color calc(var(--dur) * 0.65) var(--ease);
  }

  .vip-seat--reserved {
    border-color: rgba(184, 151, 126, 0.55);
    box-shadow:
      0 8px 40px rgba(184, 151, 126, 0.16),
      inset 0 1px 0 rgba(205, 181, 160, 0.28);
  }
  .vip-seat--reserved::after {
    border-color: rgba(184, 151, 126, 0.30);
  }

  .vip-seat--open:hover {
    border-color: rgba(184, 151, 126, 0.60);
    transform: translateY(-4px);
    box-shadow: 0 18px 50px rgba(184, 151, 126, 0.20);
  }
  .vip-seat--open:hover::after {
    border-color: rgba(184, 151, 126, 0.35);
  }

  .vip-seal {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(184, 151, 126, 0.55);
    display: grid;
    place-items: center;
    position: relative;
    background: radial-gradient(circle at 35% 30%, rgba(184, 151, 126, 0.22), rgba(184, 151, 126, 0.05));
  }
  .vip-seal::after {
    content: '';
    position: absolute;
    inset: -7px;
    border-radius: 9999px;
    border: 1px solid rgba(184, 151, 126, 0.20);
  }

  /* Open seat: dashed empty place-setting that gilds on hover */
  .vip-seal--open {
    border-style: dashed;
    border-color: rgba(255, 255, 255, 0.20);
    background: none;
    transition: border-color calc(var(--dur) * 0.65) var(--ease);
  }
  .vip-seal--open::after {
    border: none;
  }
  .vip-seat--open:hover .vip-seal--open {
    border-color: rgba(184, 151, 126, 0.55);
  }
</style>
